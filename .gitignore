# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# Data, results and model files produced or downloaded locally
/datasets/
/results/
/results_*/
/segments/
/logs/
lightning_logs/
wandb/
