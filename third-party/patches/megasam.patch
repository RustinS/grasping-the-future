-from torch_scatter import scatter_mean
+def scatter_mean(src, index, dim=0, dim_size=None):
+    """Drop-in replacement for torch_scatter.scatter_mean using native PyTorch."""
+    if dim_size is None:
+        dim_size = int(index.max()) + 1
+    shape = list(src.shape)
+    shape[dim] = dim_size
+    out_sum = torch.zeros(shape, dtype=src.dtype, device=src.device)
+    out_count = torch.zeros(shape, dtype=src.dtype, device=src.device)
+    idx = index.view([src.shape[dim] if d == dim else 1 for d in range(src.dim())])
+    idx = idx.expand_as(src)
+    out_sum.scatter_add_(dim, idx, src)
+    ones = torch.ones_like(src)
+    out_count.scatter_add_(dim, idx, ones)
+    return out_sum / out_count.clamp(min=1)
 
 
